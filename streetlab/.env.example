# Where the BROWSER build finds the simulator. Read at build time (Vite bakes it in),
# so changing it means a rebuild/redeploy.
#
#   Vercel:  Project Settings -> Environment Variables -> Production (and Preview).
#            A production build FAILS if this is unset or not wss://  (see buildGuard.ts).
#   Local:   copy to .env.local (gitignored). Unset falls back to ws://127.0.0.1:8765,
#            which is what `uv run streetlab serve` listens on.
#   Tauri:   not used; the packaged app gets its URL from the sidecar handshake.
#
# Per-visit override without rebuilding:  https://<site>/?backend=wss://other.example
# Offline demo with no backend at all:    https://<site>/?mock=1
VITE_BACKEND_WS_URL=wss://streetlab-sim.fly.dev
