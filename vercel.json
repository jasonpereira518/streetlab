{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "streetlab": {
      "root": "streetlab",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "streetlab" } }]
}
